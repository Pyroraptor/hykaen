[ext_resource type="Script" path="res://data/encounters/encounter_resource.gd" id="1_encrsc"]
[ext_resource type="Script" path="res://data/tiles/hex_tile_data_resource.gd" id="2_hextil"]

; ─────────────────────────────────────────────────────────────────────────
; FEAT-010 (US-001..US-008 / FR-001, FR-004, FR-005, FR-007, FR-008,
; FR-009, FR-010, FR-011) — the single steel-thread E2E fixture.
;
; Corridor along r=0, walked by the click-to-navigate happy path:
;   (0, 0) hero start (not itself an authored tile -- open-world default)
;   (1, 0) normal      -- Resource_normal1
;   (2, 0) difficult   -- Resource_difficult1 (ADR-006 hover/click parity
;                          proof: cost 2.0, still routed straight through
;                          since it is the only corridor, never detoured)
;   (3, 0) normal, doubles as the trigger hex authored in the test's own
;          in-memory ProximityTriggerResource.trigger_hexes -- Resource_normal2
;   (4, 0) normal, the eventual destination the click target passes
;          THROUGH the trigger hex to reach (never actually arrived at --
;          the walk halts at (3, 0)) -- Resource_normal3
; ─────────────────────────────────────────────────────────────────────────

[sub_resource type="Resource" id="Resource_normal1"]
script = ExtResource("2_hextil")
q = 1
r = 0
passable = true
difficult = false
terrain_type = "floor"
elevation = 0
cover = 0
feature = ""

[sub_resource type="Resource" id="Resource_difficult1"]
script = ExtResource("2_hextil")
