; Engine configuration file.
; It's best edited using the Godot editor.
; /!\  Do not edit this file manually if you are not sure what you are doing.
; Your changes may be overwritten by the editor.

config_version=5

[application]

config/name="Hykaen"
config/description="A turn-based narrative CRPG set in the world of Hykaen."
config/version="0.1.0"
config/features=PackedStringArray("4.3", "GDScript")
run/main_scene="res://game/main.tscn"
config/icon="res://icon.svg"

[autoload]

HeadlessRunner="*res://tests/runner/headless_runner.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
