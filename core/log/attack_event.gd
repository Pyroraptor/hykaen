## core/log/attack_event.gd — AttackEvent (FEAT-007 / US-007 / FR-008)
##
## Domain layer (Clean Architecture / ADR-001): a pure RefCounted value
## object — zero Node/Control/SceneTree inheritance, zero engine I/O — used
## as the STRUCTURED, storage-shaped record of one resolved Strike, distinct
## from core/rules/round_events.gd's RoundEvents.AttackBroadcast (which is the
## transient, name-carrying broadcast payload EventSinkPort fans out to
## Presentation for immediate rendering). This file's AttackEvent is the
## design's data_model entity: attacker/target/weapon referenced by id
## (never duplicated inline, 3NF-equivalent), meant to be retained by
## presentation/event_log_view.gd's structured storage (record_attack()) and
## correlated with zero-to-two ReactionResolvedEvent instances by `id`
## (see reaction_resolved_event.gd's `attack_event_id`).
##
## Fields (design notes' data_model):
##   id                    — caller-assigned unique identifier for this
##                            Strike (e.g. core/application/round_session.gd's
##                            "R<round>-A<n>" generator). Never generated by
##                            this class itself — a pure value object assigns
##                            no identity of its own.
##   round_number          — the round this Strike was resolved in.
##   attacker_id           — the attacking combatant's stable id.
##   target_id             — the defending combatant's stable id.
##   weapon_id             — the attacker's weapon's stable id.
##   roll_total            — the attack roll total (already includes
##                            modifiers), mirrors RoundEvents.AttackBroadcast.roll.
##   is_hit / is_crit       — the Strike's hit/critical result.
##   damage_raw            — damage before any on-hit mitigation is applied.
##   damage_final          — damage after on-hit mitigation (equal to
##                            damage_raw when no mitigation was applied).
##   on_hit_suppressed     — true when a PreHitAvoidance reaction (Dodge/
##                            Steel) already consumed this Strike's
##                            <=1-reaction-per-Strike budget, so the on-hit
##                            window was never offered.
##   defender_stepped      — true when the defender's chosen active defense
##                            involved a step/reposition (mirrors
##                            core/rules/resolution.gd's defender_stepped
##                            result key).
##   created_at            — caller-supplied timestamp/ordering value
##                            (never computed internally — see file-level
##                            doc: a pure value object must stay
##                            deterministic/test-friendly).
class_name AttackEvent
extends RefCounted

var id
var round_number: int
var attacker_id: String
var target_id: String
var weapon_id: String
var roll_total: int
var is_hit: bool
var is_crit: bool
var damage_raw: int
var damage_final: int
var on_hit_suppressed: bool
var defender_stepped: bool
var created_at: int


func _init(
	p_id = "",
	p_round_number: int = 0,
	p_attacker_id: String = "",
	p_target_id: String = "",
	p_weapon_id: String = "",
	p_roll_total: int = 0,
	p_is_hit: bool = false,
	p_is_crit: bool = false,
	p_damage_raw: int = 0,
	p_damage_final: int = 0,
	p_on_hit_suppressed: bool = false,
	p_defender_stepped: bool = false,
	p_created_at: int = 0
) -> void:
	id                = p_id
	round_number      = p_round_number
	attacker_id       = p_attacker_id
	target_id         = p_target_id
	weapon_id         = p_weapon_id
	roll_total        = p_roll_total
	is_hit            = p_is_hit
	is_crit           = p_is_crit
	damage_raw        = p_damage_raw
	damage_final      = p_damage_final
	on_hit_suppressed = p_on_hit_suppressed
	defender_stepped  = p_defender_stepped
	created_at        = p_created_at


## to_dict() → Dictionary — snapshot of all fields, for assertions/logging,
## mirroring core/rules/round_events.gd's established to_dict() convention.
func to_dict() -> Dictionary:
	return {
		"id":                id,
		"round_number":      round_number,
		"attacker_id":       attacker_id,
		"target_id":         target_id,
		"weapon_id":         weapon_id,
		"roll_total":        roll_total,
		"is_hit":            is_hit,
		"is_crit":           is_crit,
		"damage_raw":        damage_raw,
		"damage_final":      damage_final,
		"on_hit_suppressed": on_hit_suppressed,
		"defender_stepped":  defender_stepped,
		"created_at":        created_at,
	}
