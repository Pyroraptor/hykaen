## core/log/reaction_resolved_event.gd — ReactionResolvedEvent
## (FEAT-007 / US-007 / FR-008)
##
## Domain layer (Clean Architecture / ADR-001): a pure RefCounted value
## object — zero Node/Control/SceneTree inheritance, zero engine I/O — the
## STRUCTURED, storage-shaped record of one resolved reaction window,
## distinct from core/rules/round_events.gd's RoundEvents.ReactionResolvedBroadcast
## (the transient broadcast payload EventSinkPort fans out for immediate
## rendering). This file's ReactionResolvedEvent is the design's data_model
## entity meant to be retained by presentation/event_log_view.gd's
## structured storage (record_reaction()) and correlated to exactly one
## AttackEvent (attack_event.gd) via the composite key
## `attack_event_id` + `window_id` — the FK-level expression of the
## <=1-reaction-per-Strike budget invariant (at most one ReactionResolvedEvent
## per (attack_event_id, window_id) pair; event_log_view.gd's record_reaction()
## rejects a duplicate window firing for the SAME pair).
##
## Fields (design notes' data_model):
##   id                — caller-assigned unique identifier for this
##                       ReactionResolvedEvent. Never generated by this
##                       class itself.
##   attack_event_id   — the correlated AttackEvent's id (nullable only for
##                       a non-attack-correlated reaction; NOT NULL and
##                       unique-per-window_type for every attack-correlated
##                       reaction — enforced at the storage layer, not here).
##   window_id         — "PreHitAvoidance" | "OnHitMitigation".
##   choice            — "dodge" | "steel" | "parry" | "block" | "none"
##                       (mirrors core/application/round_session.gd's
##                       _VALID_ACTIVE_DEFENSES convention plus "none" for
##                       an explicit Pass).
##   resolved_by       — "human" | "ai" | "auto" (who made the choice).
##   outcome           — "dodge_succeeded" | "dodge_failed" |
##                       "parry_succeeded" | "parry_failed" |
##                       "block_reduced_by_n" | "none".
##   reduced_by        — nullable int; the amount of damage a
##                       "block_reduced_by_n" outcome reduced by.
class_name ReactionResolvedEvent
extends RefCounted

var id
var attack_event_id
var window_id: String
var choice: String
var resolved_by: String
var outcome: String
var reduced_by


func _init(
	p_id = "",
	p_attack_event_id = null,
	p_window_id: String = "",
	p_choice: String = "none",
	p_resolved_by: String = "unknown",
	p_outcome: String = "none",
	p_reduced_by = null
) -> void:
	id              = p_id
	attack_event_id = p_attack_event_id
	window_id       = p_window_id
	choice          = p_choice
	resolved_by     = p_resolved_by
	outcome         = p_outcome
	reduced_by      = p_reduced_by


## to_dict() → Dictionary — snapshot of all fields, for assertions/logging,
## mirroring core/rules/round_events.gd's established to_dict() convention.
func to_dict() -> Dictionary:
	return {
		"id":              id,
		"attack_event_id": attack_event_id,
		"window_id":       window_id,
		"choice":          choice,
		"resolved_by":     resolved_by,
		"outcome":         outcome,
		"reduced_by":      reduced_by,
	}
