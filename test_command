#!/usr/bin/env bash
# test_command — FEAT-004 / US-014
#
# Single, canonical automated test gate for the hykaen project. Wires
# together pytest (CI/infra + config assertions under tests/unit/*.py) and
# the Godot GUT suite (headless), so a single command gives one green/red
# signal for the whole project.
#
# Runs, in order, aborting immediately (non-zero exit) if any stage fails:
#
#   1. FEAT-006 / US-013 headless launchability smoke test
#      (tests/smoke/test_main_scene_headless_boot.gd) — boots the project's
#      composition-root entry point (MainScene.tscn, FEAT-005/US-004)
#      headlessly and asserts autoload resolution + first-frame processing.
#      Run via GUT's real CLI entry point (addons/gut/gut_cmdln.gd, -gdir=)
#      rather than the -- --gut-run-all/HeadlessRunner path, so this stage
#      can be scoped to just tests/smoke/ — a cheap, EARLY regression signal
#      for the entry point, ahead of every other stage below, before any
#      UI/Presentation layer work begins.
#   2. pytest — the full Python test suite.
#   3. The CONSOLIDATED domain suite via tests/.gutconfig.json — hex
#      distance/adjacency (test_hex_coord.gd, test_hex_math.gd),
#      Combatant hex-coordinate init (test_combatant_hex_init.gd), and
#      melee reach gating (test_resolve_action_reach.gd). This is the
#      single green gate for the new hex/reach domain logic (US-001,
#      US-002, US-003) that must pass before any UI work begins. Run via
#      GUT's real CLI entry point (addons/gut/gut_cmdln.gd, -gconfig=)
#      rather than the -- --gut-run-all/HeadlessRunner path: the project's
#      HeadlessRunner autoload (tests/runner/headless_runner.gd) hardcodes
#      loading res://.gutconfig.json for a bare --gut-run-all flag and
#      ignores any -gconfig= passed alongside it, which would silently
#      widen this stage to the full project suite instead of the intended
#      4-script consolidated domain suite. Invoking gut_cmdln.gd directly
#      (as stage 1 already does) honors -gconfig= and keeps this stage a
#      genuinely scoped, fast gate.
#   4. The FULL project-wide GUT suite (root .gutconfig.json) via
#      --gut-run-all, as a whole-project regression gate.
#   5. FEAT-113 / US-015 steel thread prologue-encounter E2E test
#      (tests/integration/test_steel_thread_prologue_encounter.gd) — already
#      covered by stage 4's full-project run, but called out here as its own
#      explicit, clearly-labeled gate: it headlessly boots MainScene.tscn
#      into prologue_encounter.tres, verifies the hex battlefield/status/
#      initiative render, drives a player melee Strike and a full
#      AI-controlled enemy turn through the real Presentation/event
#      pipeline, confirms the Win/Loss ResultScreenView with input disabled
#      afterward, and re-confirms determinism (NFR-002/006) by booting the
#      same seeded encounter twice. This is the steel thread's closing,
#      automated exit-point proof for US-015. Run via GUT's real CLI entry
#      point with -gselect= scoped to this one script (mirroring stage 1/3's
#      -gdir=/-gconfig= convention of invoking gut_cmdln.gd directly rather
#      than the -- --gut-run-all/HeadlessRunner path).
#
# Exit code: 0 only if every stage above exits 0. `set -e` (plus
# pipefail) ensures a single failing assertion anywhere aborts the
# script with a non-zero exit code.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

echo "=== [1/5] FEAT-006 / US-013 headless launchability smoke test (tests/smoke/) ==="
godot --headless -s addons/gut/gut_cmdln.gd -gdir=res://tests/smoke -ginclude_subdirs -gexit

echo "=== [2/5] pytest suite ==="
python -m pytest -q --tb=short

echo "=== [3/5] GUT consolidated domain suite (tests/.gutconfig.json) ==="
echo "    -> test_hex_coord.gd, test_hex_math.gd, test_combatant_hex_init.gd, test_resolve_action_reach.gd, test_round_session.gd, test_round_session_ai_turn.gd"
godot --headless -s addons/gut/gut_cmdln.gd -gconfig=res://tests/.gutconfig.json -gexit

echo "=== [4/5] GUT full project suite (root .gutconfig.json, regression gate) ==="
godot --headless -- --gut-run-all

echo "=== [5/5] FEAT-113 / US-015 steel thread prologue-encounter E2E test ==="
godot --headless -s addons/gut/gut_cmdln.gd -gselect=test_steel_thread_prologue_encounter.gd -gdir=res://tests/integration -ginclude_subdirs -gexit

echo "=== test_command: all stages passed ==="
