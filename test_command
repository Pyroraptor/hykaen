#!/usr/bin/env bash
# test_command — FEAT-004 / FEAT-136 / US-011 / US-014 (DEF-002, DEF-003)
#
# Thin delegating wrapper around scripts/test_command.sh — the single
# canonical automated test gate for the hykaen project, declared as the
# pipeline entry point by ci/pipeline.yml's `test_command:` key and
# invoked directly by .github/workflows/test.yml's CI job.
#
# This root-level script exists only so a bare `./test_command` (or
# `bash test_command`) keeps working for developer muscle-memory and any
# tooling that expects a root-level entry point — it defines NO stages of
# its own. Previously, this file and scripts/test_command.sh independently
# hand-duplicated divergent stage lists and guard env vars (DEF-002 /
# DEF-003); reconciling them means there is now exactly ONE place stages
# are defined (scripts/test_command.sh), so the two scripts can never
# drift out of sync again.
#
# `set -euo pipefail` + `exec` preserve the exact same guard-var /
# fail-fast semantics as scripts/test_command.sh itself: any failure in
# the delegated script aborts with a non-zero exit code, and `exec`
# replaces this process with scripts/test_command.sh so the exit code —
# and the calling environment (including any test-recursion guard env
# vars such as HYKAEN_TEST_COMMAND_E2E_GUARD) — propagate through
# unchanged, with no intermediate wrapper process left over.

set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

exec "$(dirname "${BASH_SOURCE[0]}")/scripts/test_command.sh" "$@"
